rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Get user data - SAFE ACCESS
    function getUserData() {
      let userDoc = request.auth != null ? get(/databases/$(database)/documents/users/$(request.auth.uid)) : null;
      return userDoc != null ? userDoc.data : {};
    }
    
    // Check if user belongs to the org
    function belongsToOrg(orgId) {
      let data = getUserData();
      let userOrgId = "orgId" in data ? data.orgId : ("organizationId" in data ? data.organizationId : null);
      return request.auth != null && userOrgId != null && userOrgId == orgId;
    }

    // Check if user is the document owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Check if user is superadmin (platform-level access)
    function isSuperAdmin() {
      let data = getUserData();
      return request.auth != null && "role" in data && data.role == "superadmin";
    }
    
    // Check if user is admin of their org
    function isOrgAdmin(orgId) {
      let data = getUserData();
      return belongsToOrg(orgId) && "role" in data && data.role in ["owner", "admin", "superadmin"];
    }
    
    // Validate orgId is present on create
    function hasValidOrgId() {
      return request.resource.data.orgId != null && request.resource.data.orgId != "";
    }
    
    // Check org access for read operations (resource exists)
    function canReadByOrg() {
      return belongsToOrg(resource.data.orgId) || isSuperAdmin();
    }
    
    // Check org access for create operations
    function canCreateByOrg() {
      return hasValidOrgId() && (belongsToOrg(request.resource.data.orgId) || isSuperAdmin());
    }
    
    // Check org access for update/delete operations
    function canModifyByOrg() {
      return belongsToOrg(resource.data.orgId) || isSuperAdmin();
    }

    // ============================================
    // USER MANAGEMENT
    // ============================================
    
    // Users: Users can read/write their own profile, superadmins can read all
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isSuperAdmin();
      
      // Allow access to subcollections (e.g. onboarding)
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Staff
    match /staff/{staffId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // ============================================
    // ORGANIZATION MANAGEMENT
    // ============================================
    
    // Organizations: Members can read/update, superadmins have full access
    match /organizations/{orgId} {
      // Allow read for all users (including unauthenticated for subdomain check during signup)
      allow read: if true;
      // Allow write only if org admin
      // Allow create if user is listed as owner OR if they meet the old check
      allow create: if (request.auth != null && request.resource.data.ownerId == request.auth.uid) || canCreateByOrg();
      // Allow update if user is the org owner OR org admin
      allow update: if (request.auth != null && resource.data.ownerId == request.auth.uid) || isOrgAdmin(orgId) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      match /settings/{settingId} {
        allow read: if belongsToOrg(orgId) || isSuperAdmin();
        allow write: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      match /branding/{fileId} {
        allow read: if true; // Public read for logos/branding
        allow write: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      // User-specific settings (dashboard layout, preferences)
      // Users can only read/write their own settings
      match /userSettings/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Counters (for invoice numbers etc)
      match /counters/{counterId} {
        allow read: if belongsToOrg(orgId) || isSuperAdmin();
        allow write: if belongsToOrg(orgId) || isSuperAdmin(); // Allow write for atomic increments
      }

      // Organization activity feed (audit log)
      match /activities/{activityId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      // Allow access to other subcollections (admin access)
      match /{document=**} {
        allow read: if belongsToOrg(orgId) || isSuperAdmin();
        allow write: if isOrgAdmin(orgId) || isSuperAdmin();
      }
    }
    
    // Platform subscriptions (superadmin only)
    match /platformSubscriptions/{subId} {
      allow read, write: if isSuperAdmin();
    }

    // ============================================
    // CRM - CUSTOMERS & LEADS
    // ============================================
    
    // Customers
    match /customers/{customerId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
      
      // Customer contacts
      match /contacts/{contactId} {
        allow read: if canReadByOrg();
        allow create: if canCreateByOrg();
        allow update, delete: if canModifyByOrg();
      }

      // Customer Notes
      match /notes/{noteId} {
        allow read: if canReadByOrg();
        allow create: if canCreateByOrg();
        allow update, delete: if canModifyByOrg();
      }
    }
    
    // Legacy clients collection
    match /clients/{clientId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
      
      match /contacts/{contactId} {
        allow read: if canReadByOrg();
        allow create: if canCreateByOrg();
        allow update, delete: if canModifyByOrg();
      }
    }
    
    // Leads
    match /leads/{leadId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // Lead Notes
    match /leadNotes/{noteId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // Lead Reminders
    match /leadReminders/{reminderId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // Lead Attachments
    match /leadAttachments/{attachmentId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // ============================================
    // SALES - INVOICES, ESTIMATES, PROPOSALS
    // ============================================
    
    // Invoices
    match /invoices/{invoiceId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }
    
    // Estimates
    match /estimates/{estimateId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }
    
    // Proposals
    match /proposals/{proposalId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }
    
    // Contracts
    match /contracts/{contractId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // ============================================
    // PROJECT MANAGEMENT
    // ============================================
    
    // Projects
    match /projects/{projectId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
      
      // Project tasks
      match /tasks/{taskId} {
        allow read: if canReadByOrg();
        allow create: if canCreateByOrg();
        allow update, delete: if canModifyByOrg();
      }
    }
    
    // Standalone tasks
    match /tasks/{taskId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // ============================================
    // SUPPORT
    // ============================================
    
    // Support tickets
    match /support_tickets/{ticketId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
      
      // Ticket messages
      match /messages/{messageId} {
        allow read: if canReadByOrg();
        allow create: if canCreateByOrg();
        allow update, delete: if canModifyByOrg();
      }
    }

    // ============================================
    // OTHER ROOT COLLECTIONS
    // ============================================

    // Contacts (Root level access needed for useContacts hook)
    match /contacts/{contactId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // Expense Categories
    match /expenseCategories/{categoryId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // Taxes
    match /taxes/{taxId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // Notifications
    match /notifications/{notificationId} {
      // Notifications might need user-specific access too, but org-based is a good baseline
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // ============================================
    // SUBSCRIPTIONS (TENANT LEVEL)
    // ============================================
    
    // Customer subscriptions
    match /subscriptions/{subId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // ============================================
    // PLATFORM CONFIG (SUPERADMIN)
    // ============================================
    
    // Platform-level configuration (landing page, etc.)
    match /platform/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // Subscription plans
    match /platform/subscriptionPlans/plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ============================================
    // OTHER COLLECTIONS
    // ============================================

    // Join Requests
    match /join_requests/{requestId} {
      // Need special handling? Likely new users don't have org yet?
      // For now, allow auth users to create, but read restrictive?
      // Actually, join requests usually involve orgId.
      allow read: if canReadByOrg();
      allow create: if request.auth != null; // Allow creation by any auth user
      allow update, delete: if canModifyByOrg();
    }

    // Roles
    match /roles/{roleId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // Analytics
    match /analytics/{docId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
      
      match /{document=**} {
        allow read, write: if canReadByOrg();
      }
    }

    // Invitations
    match /invitations/{inviteId} {
      allow read: if canReadByOrg();
      allow create: if canCreateByOrg();
      allow update, delete: if canModifyByOrg();
    }

    // ============================================
    // CATCH-ALL DENY
    // ============================================
    
    // Deny access to any undefined collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
