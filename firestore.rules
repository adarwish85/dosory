rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // SUPER ADMIN COLLECTIONS - STRICT ACCESS
    // ============================================
    
    // Super Admin Audit Logs - IMMUTABLE
    // Only create and read allowed, no update or delete
    match /sa_audit_logs/{logId} {
      allow create: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      allow read: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      // Audit logs are immutable - no updates or deletes
      allow update, delete: if false;
    }
    
    // SA Plans - Super Admin only
    match /sa_plans/{planId} {
      allow read: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      allow write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
    }
    
    // SA Modules - Super Admin only
    match /sa_modules/{moduleId} {
      allow read: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      allow write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
    }
    
    // SA Support Issues - Super Admin only
    match /sa_support_issues/{issueId} {
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
    }
    
    // ============================================
    // WEBSITE BUILDER COLLECTIONS - SUPER ADMIN
    // ============================================
    
    // Websites - Super Admin only
    match /websites/{websiteId} {
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      
      // Pages subcollection
      match /pages/{pageId} {
        allow read, write: if request.auth != null 
          && request.auth.token.isSuperAdmin == true;
      }
      
      // Sections subcollection  
      match /sections/{sectionId} {
        allow read, write: if request.auth != null 
          && request.auth.token.isSuperAdmin == true;
      }
    }
    
    // Website assets - Super Admin only
    match /website_assets/{assetId} {
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
    }
    
    // ============================================
    // MULTI-TENANT DATA COLLECTIONS
    // ============================================
    
    // Organizations (Tenants) - Super Admin can read/write all
    // Tenant members can only access their own org
    match /organizations/{orgId} {
      // Super Admins have full access
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      
      // Org members can read their own organization
      allow read: if request.auth != null 
        && request.auth.uid in resource.data.memberIds;
      
      // Org admins can update their organization
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.ownerId;
    }
    
    // Global Users - Super Admin can read/write all
    match /users/{userId} {
      // Super Admins have full access
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      
      // Users can read and update their own profile
      allow read, update: if request.auth != null 
        && request.auth.uid == userId;
    }
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.isSuperAdmin == true;
    }

    function isOrgMember(orgId) {
       // Check if the user has the custom claim 'orgId' matching the document's orgId
       return request.auth != null && request.auth.token.orgId == orgId;
    }
    
    function isOrgAdmin(orgId) {
       return isOrgMember(orgId) && request.auth.token.role == 'admin';
    }

    // ============================================
    // ROOT COLLECTIONS (TENANT ISOLATED)
    // ============================================

    // Generic rule for simple tenant-isolated collections
    // Only allows access if the document's `orgId` matches the user's `orgId` claim.
    match /leads/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }

    match /customers/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }

    match /contacts/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }

    match /projects/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /tasks/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }

    match /employees/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }

    match /files/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }

    match /activities/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /invoices/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /payments/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /expenses/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /proposals/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /estimates/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }

    match /reminders/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /contracts/{docId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /staff/{docId} {
       // Staff is slightly different, it might be looked up by ID or query.
       // Usually it has orgId field.
      allow read, write: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    // Notifications - usually filtered by userId, but orgId check is good too
    match /notifications/{docId} {
       allow read, update: if isSuperAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
       allow create: if isSuperAdmin() || (request.auth != null && request.resource.data.userId == request.auth.uid) || (isOrgMember(request.resource.data.orgId)); // Allow creating relevant notifications
    }


    // ============================================
    // TENANT-SCOPED COLLECTIONS (LEGACY / SPECIFIC)
    // ============================================
    
    // Pattern for tenant-scoped data
    // Usage: /tenantData/{orgId}/students/{studentId}
    match /tenantData/{orgId}/{collection}/{docId} {
      // Super Admins have full access to all tenant data
      allow read, write: if isSuperAdmin();
      
      // Tenant members can access their own tenant's data
      allow read, write: if isOrgMember(orgId);
    }
    
    // ============================================
    // DEFAULT: DENY ALL
    // ============================================
    
    // Any path not explicitly matched is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
