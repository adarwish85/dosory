rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // SUPER ADMIN COLLECTIONS - STRICT ACCESS
    // ============================================
    
    // Super Admin Audit Logs - IMMUTABLE
    // Only create and read allowed, no update or delete
    match /sa_audit_logs/{logId} {
      allow create: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      allow read: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      // Audit logs are immutable - no updates or deletes
      allow update, delete: if false;
    }
    
    // SA Plans - Super Admin only
    match /sa_plans/{planId} {
      allow read: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      allow write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
    }
    
    // SA Modules - Super Admin only
    match /sa_modules/{moduleId} {
      allow read: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      allow write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
    }
    
    // SA Support Issues - Super Admin only
    match /sa_support_issues/{issueId} {
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
    }
    
    // ============================================
    // WEBSITE BUILDER COLLECTIONS - SUPER ADMIN
    // ============================================
    
    // Websites - Super Admin only
    match /websites/{websiteId} {
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      
      // Pages subcollection
      match /pages/{pageId} {
        allow read, write: if request.auth != null 
          && request.auth.token.isSuperAdmin == true;
      }
      
      // Sections subcollection  
      match /sections/{sectionId} {
        allow read, write: if request.auth != null 
          && request.auth.token.isSuperAdmin == true;
      }
    }
    
    // Website assets - Super Admin only
    match /website_assets/{assetId} {
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
    }
    
    // ============================================
    // MULTI-TENANT DATA COLLECTIONS
    // ============================================
    
    // Organizations (Tenants) - Super Admin can read/write all
    // Tenant members can only access their own org
    match /organizations/{orgId} {
      // Super Admins have full access
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      
      // Org members can read their own organization (via orgId claim)
      allow read: if request.auth != null 
        && request.auth.token.orgId == orgId;
      
      // Org admins can update their organization
      allow update: if request.auth != null 
        && request.auth.token.orgId == orgId
        && request.auth.token.role == 'admin';

      // NEW: Allow authenticated users to create a new organization (for signup)
      allow create: if isAuthenticated() 
        && request.resource.data.ownerId == request.auth.uid;
    }
    
    // Global Users - Super Admin can read/write all
    match /users/{userId} {
      // Super Admins have full access
      allow read, write: if request.auth != null 
        && request.auth.token.isSuperAdmin == true;
      
      // Users can read and update their own profile
      allow read, write: if request.auth != null 
        && request.auth.uid == userId;
    }
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.isSuperAdmin == true;
    }

    // Check if user has the correct orgId claim matching the document
    function isOrgMember(orgId) {
       return isAuthenticated() && request.auth.token.orgId == orgId;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // ROOT COLLECTIONS (TENANT ISOLATED)
    // ============================================

    // Common rule for standard tenant collections:
    // Read/Write: SuperAdmin OR OrgMember (where doc.orgId == claim.orgId)
    // Create: SuperAdmin OR OrgMember (where newItem.orgId == claim.orgId)
    
    match /leads/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);

      // Notes subcollection — note docs do not carry their own orgId, gate on parent lead's orgId
      match /notes/{noteId} {
        allow read, write: if isSuperAdmin() ||
          get(/databases/$(database)/documents/leads/$(docId)).data.orgId == request.auth.token.orgId;
      }

      // Catchall for any other subcollection — same parent-lead orgId gate
      match /{document=**} {
        allow read, write: if isSuperAdmin() ||
          get(/databases/$(database)/documents/leads/$(docId)).data.orgId == request.auth.token.orgId;
      }
    }

    match /customers/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);

      // Notes subcollection — note docs do not carry their own orgId, gate on parent customer's orgId
      match /notes/{noteId} {
        allow read, write: if isSuperAdmin() ||
          get(/databases/$(database)/documents/customers/$(docId)).data.orgId == request.auth.token.orgId;
      }

      // Catchall for any other subcollection — same parent-customer orgId gate
      match /{document=**} {
        allow read, write: if isSuperAdmin() ||
          get(/databases/$(database)/documents/customers/$(docId)).data.orgId == request.auth.token.orgId;
      }
    }
    
    match /customer_files/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }

    match /contacts/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }

    match /projects/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }
    
    match /tasks/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }

    match /employees/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }

    match /files/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }

    match /activities/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }
    
    match /invoices/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }
    
    match /payments/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /expenses/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /estimates/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }

    match /reminders/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }
    
    match /contracts/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    // Staff docs often use email as ID. 
    // Tenants need to read staff profiles in their org.
    // Each staff doc MUST have an `orgId` field.
    match /staff/{docId} {
      // Allow users to read their own staff doc (for sync/check)
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == docId) || (isOrgMember(resource.data.orgId));
      
      // Update/Delete: Standard org rules
      allow update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));

      // Creation: Usually done by Admin via API, but if client-side:
      // - Self-signup middle clause: the staff doc's authUid must be the caller AND the caller
      //   must be the org's ownerId (signup creates organizations/{orgId} with ownerId=user.uid
      //   in step 2, BEFORE the staff doc in step 4, so the get() finds it). This blocks
      //   cross-tenant pollution: a user can only register themselves as staff in an org they own.
      // - Admin-add-staff clause: existing admin with matching orgId claim can add anyone.
      allow create: if isSuperAdmin()
        || (
          isAuthenticated()
          && request.resource.data.authUid == request.auth.uid
          && get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.ownerId == request.auth.uid
        )
        || (isOrgMember(request.resource.data.orgId) && request.auth.token.role == 'admin');
    }
    
    // Notifications
    match /notifications/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }

    // ============================================
    // TENANT SETTINGS & CONFIG COLLECTIONS
    // ============================================
    
    match /roles/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /taxes/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /currencies/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /paymentModes/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /customFields/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /emailTemplates/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /settings/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);
    }
    
    match /dashboard_layouts/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /sticky_notes/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /departments/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /attendance/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /leaves/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /leaveTypes/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /payroll/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    // Conversations — the live chat data path used by lib/hooks/use-chat.ts.
    // Root doc carries an orgId field; messages subcollection does not, so it
    // gates on parent-conversation orgId via get() (mirrors leads/notes pattern).
    match /conversations/{docId} {
      // Tenant-scoped: any user in the same orgId can read/write; SA bypass
      allow read, update, delete: if isSuperAdmin() || isOrgMember(resource.data.orgId);
      allow create: if isSuperAdmin() || isOrgMember(request.resource.data.orgId);

      // Messages subcollection — message docs do not carry their own orgId, gate on parent conversation's orgId
      match /messages/{messageId} {
        allow read, write: if isSuperAdmin() ||
          get(/databases/$(database)/documents/conversations/$(docId)).data.orgId == request.auth.token.orgId;
      }
    }

    match /support_tickets/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /credit_notes/{docId} {
      allow read, update, delete: if isSuperAdmin() || (isOrgMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (isOrgMember(request.resource.data.orgId));
    }
    
    match /subscriptions/{docId} {
      // Subscriptions are managed by API, tenants can read their own
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.token.orgId == docId);
      allow write: if isSuperAdmin();
    }
    
    match /tenantUsage/{docId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.token.orgId == docId);
      allow write: if isSuperAdmin();
    }


    // ============================================
    // TENANT-SCOPED COLLECTIONS (LEGACY / SPECIFIC)
    // ============================================
    
    match /tenantData/{orgId}/{collection}/{docId} {
      allow read, write: if isSuperAdmin() || isOrgMember(orgId);
    }

    // ============================================
    // PLATFORM & SYSTEM COLLECTIONS
    // ============================================
    
    // Platform docs — Stage 3.0.4 split. Three named docs serve anonymous
    // landing/signup pages and stay publicly readable. Everything else under
    // platform/ defaults to SA-only, so a future doc with sensitive content
    // (e.g. another credential blob) does not silently leak.
    //
    // Documented public docs (must never contain secrets):
    //   - platform/settings    (read by PlatformSettingsProvider on every page — maintenanceMode,
    //                            allowSignups, requireEmailVerification, branding)
    //   - platform/landing     (legacy migration source for use-site-pages.ts)
    //   - platform/siteDesign  (public landing reads for design tokens)
    // SMTP credentials previously in platform/settings.smtpSettings were migrated to
    // Secret Manager (env SMTP_PASSWORD) in this commit; Ahmed deletes the lingering
    // smtpSettings field manually post-deploy.
    match /platform/settings {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /platform/landing {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /platform/siteDesign {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    // Catch-all for any OTHER platform/* doc (existing emailTemplates / subscriptionPlans
    // parent docs, plus any new doc that hasn't been explicitly allow-listed). SA-only.
    match /platform/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // System Banners - read by all authenticated, write by SuperAdmin
    match /system_banners/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Analytics events — Stage 3.0.3: create now requires the doc's orgId matches the caller's
    // token claim, preventing authenticated cross-tenant pollution of the shared event log.
    match /analytics/{category}/events/{docId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.orgId == request.auth.token.orgId;
    }
    
    // ============================================
    // SUBCOLLECTION RULES
    // ============================================
    
    // Organization Settings Subcollection
    match /organizations/{orgId}/settings/{docId} {
      allow read, write: if isSuperAdmin() || isOrgMember(orgId);
    }
    
    // Organization User Settings Subcollection (dashboard layouts, preferences)
    match /organizations/{orgId}/userSettings/{userId} {
      allow read, write: if isSuperAdmin() || (isOrgMember(orgId) && isOwner(userId));
    }
    
    // User Onboarding State Subcollection
    match /users/{userId}/onboarding/{docId} {
      allow read, write: if isSuperAdmin() || isOwner(userId);
    }
    
    // User Settings Subcollection (sticky notes, personal preferences)
    match /users/{userId}/settings/{docId} {
      allow read, write: if isSuperAdmin() || isOwner(userId);
    }
    
    // ============================================
    // DEFAULT: CATCH-ALL FOR TENANT-ISOLATED COLLECTIONS
    // ============================================
    // Allow authenticated users to access documents where orgId matches their token claim
    // This catches any tenant-isolated collections not explicitly defined above
    
    match /{collection}/{docId} {
      // Allow read/write if authenticated and document's orgId matches user's token orgId
      allow read, write: if isAuthenticated() 
        && resource.data.orgId != null 
        && request.auth.token.orgId == resource.data.orgId;
      // Allow create if authenticated and new document's orgId matches user's token orgId  
      allow create: if isAuthenticated()
        && request.resource.data.orgId != null
        && request.auth.token.orgId == request.resource.data.orgId;
    }
    
    // Final deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
